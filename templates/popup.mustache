{{!
    @template block_scicalc/popup

    Floating toggle button and calculator dialog. Rendered by block_scicalc/popup
    and appended to document.body.

    Context variables required for this template:
    * buttons - keypad buttons in grid order
      * label - text on the button
      * action - what the button does (insert, wrap, ans, negate, backspace, clear, equals)
      * value - text inserted for insert/wrap buttons
      * style - colour variant (num, op, func, warning, danger, primary)
      * arialabel - optional accessible name when the label is a symbol
      * tall - optional, spans three grid rows (the = key)

    Example context (json):
    {
        "buttons": [
            {"label": "7", "action": "insert", "value": "7", "style": "num"},
            {"label": "LOG", "action": "wrap", "value": "log()", "style": "func", "arialabel": "log"},
            {"label": "=", "action": "equals", "value": "", "style": "primary"}
        ]
    }
}}
<button type="button" id="scicalc-toggle-btn" aria-expanded="false" aria-controls="scicalc-popup">
    {{> block_scicalc/icon }}{{#str}} calculator, block_scicalc {{/str}}
</button>
<div id="scicalc-popup" role="dialog" aria-labelledby="scicalc-title" hidden>
    <div id="scicalc-drag-handle">
        <span id="scicalc-title">{{> block_scicalc/icon }}{{#str}} pluginname, block_scicalc {{/str}}</span>
        <button type="button" id="scicalc-close-btn" aria-label="{{#str}} close, block_scicalc {{/str}}">&times;</button>
    </div>
    <div id="scicalc-popup-body">
        <div class="scicalc-input-row">
            <label for="scicalc-display" class="visually-hidden">{{#str}} display, block_scicalc {{/str}}</label>
            <input type="text" id="scicalc-display"
                   autocomplete="off" spellcheck="false" inputmode="none"
                   placeholder="{{#str}} displayplaceholder, block_scicalc {{/str}}">
        </div>
        <div id="scicalc-error" class="scicalc-error" role="alert" hidden></div>
        <div class="scicalc-grid">
            {{#buttons}}
            <button type="button" class="scicalc-btn scicalc-btn-{{style}}{{#tall}} scicalc-btn-tall{{/tall}}"
                    data-action="{{action}}" data-value="{{value}}"{{#arialabel}} aria-label="{{.}}"{{/arialabel}}>{{label}}</button>
            {{/buttons}}
        </div>
        <div class="scicalc-history-header">
            <span id="scicalc-history-title">{{#str}} history_title, block_scicalc {{/str}}</span>
            <button type="button" id="scicalc-clear-history" class="scicalc-clear-history">
                {{#str}} clear_history, block_scicalc {{/str}}
            </button>
        </div>
        <div id="scicalc-history" class="list-group list-group-flush" aria-labelledby="scicalc-history-title"></div>
    </div>
</div>
